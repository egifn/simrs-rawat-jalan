# Environment and secrets
**/.env
**/.env.*
!**/.env.example

# Dependencies
**/node_modules/
**/vendor/

# Build output
**/dist/
**/dist-ssr/

# Yii runtime files
/backend-yii/runtime/*
!/backend-yii/runtime/.gitignore
/backend-yii/web/assets/*
!/backend-yii/web/assets/.gitignore

# Logs and temporary files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*
*.tmp

# Operating system and editor files
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
