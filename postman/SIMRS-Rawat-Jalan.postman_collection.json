{
  "info": {
    "_postman_id": "d56f7306-e0e6-4d80-a65e-80f8a6ef5148",
    "name": "SIMRS Rawat Jalan - Local API",
    "description": "Collection request utama untuk menguji Yii2 dan Node.js secara lokal. Isi variabel pada environment lokal; jangan simpan credential atau token ke repository.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    { "key": "base_url_yii", "value": "http://localhost:8000/api" },
    { "key": "base_url_node", "value": "http://localhost:3001/api" },
    { "key": "token", "value": "" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "" },
    { "key": "visit_id", "value": "" },
    { "key": "billing_id", "value": "" },
    { "key": "resep_id", "value": "" },
    { "key": "lab_id", "value": "" },
    { "key": "payment_amount", "value": "1000" },
    { "key": "payment_key", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Health Node",
      "request": {
        "method": "GET",
        "url": "{{base_url_node}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Service Node merespons HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response menandakan service aktif', function () { pm.expect(pm.response.json().success).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{base_url_yii}}/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login berhasil', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "if (body.success && body.data && body.data.token) pm.environment.set('token', body.data.token);",
              "pm.test('Response menyediakan token', function () { pm.expect(body.data && body.data.token).to.be.a('string'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - User Aktif",
      "request": {
        "method": "GET",
        "url": "{{base_url_yii}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Token diterima', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Daftar Pasien",
      "request": {
        "method": "GET",
        "url": "{{base_url_yii}}/pasien"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Daftar pasien dapat dimuat', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Daftar Kunjungan Berhalaman",
      "request": {
        "method": "GET",
        "url": "{{base_url_yii}}/kunjungan?paginated=1&page=1&page_size=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Daftar kunjungan dapat dimuat', function () { pm.response.to.have.status(200); });",
              "const body = pm.response.json();",
              "pm.test('Response memiliki data pagination', function () { pm.expect(body.data).to.have.property('items'); pm.expect(body.data).to.have.property('total'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Detail Kunjungan",
      "request": {
        "method": "GET",
        "url": "{{base_url_yii}}/kunjungan/{{visit_id}}"
      }
    },
    {
      "name": "07 - Antrean Farmasi",
      "request": {
        "method": "GET",
        "url": "{{base_url_yii}}/farmasi/antrean?limit=50&offset=0"
      }
    },
    {
      "name": "08 - Detail Billing",
      "request": {
        "method": "GET",
        "url": "{{base_url_yii}}/billing/kunjungan/{{visit_id}}"
      }
    },
    {
      "name": "09 - Pembayaran (data uji saja)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"idempotency_key\": \"{{payment_key}}\",\n  \"metode_pembayaran\": \"TUNAI\",\n  \"jumlah_bayar\": {{payment_amount}}\n}"
        },
        "url": "{{base_url_yii}}/billing/bayar/{{billing_id}}"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('payment_key')) pm.environment.set('payment_key', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Pembayaran awal diterima', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const original = pm.response.json().data;",
              "  const requestUrl = pm.variables.replaceIn(pm.request.url.toString());",
              "  const requestBody = pm.variables.replaceIn(pm.request.body.raw);",
              "  const authHeader = 'Bearer ' + pm.environment.get('token');",
              "  pm.sendRequest({ url: requestUrl, method: 'POST', header: { 'Content-Type': 'application/json', 'Authorization': authHeader }, body: { mode: 'raw', raw: requestBody } }, function (error, response) {",
              "    pm.test('Retry dengan key dan payload sama tidak membuat pembayaran baru', function () {",
              "      pm.expect(error).to.eql(null);",
              "      pm.expect(response.code).to.eql(200);",
              "      const replay = response.json().data;",
              "      pm.expect(replay.idempotent_replay).to.eql(true);",
              "      pm.expect(replay.pembayaran.id).to.eql(original.pembayaran.id);",
              "    });",
              "    const changedPayload = JSON.parse(requestBody);",
              "    changedPayload.jumlah_bayar = Number(changedPayload.jumlah_bayar) + 1;",
              "    pm.sendRequest({ url: requestUrl, method: 'POST', header: { 'Content-Type': 'application/json', 'Authorization': authHeader }, body: { mode: 'raw', raw: JSON.stringify(changedPayload) } }, function (changedError, changedResponse) {",
              "      pm.test('Key yang sama dengan nominal berbeda ditolak', function () {",
              "        pm.expect(changedError).to.eql(null);",
              "        pm.expect(changedResponse.code).to.eql(409);",
              "      });",
              "    });",
              "  });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Daftar Permintaan Lab (Node)",
      "request": {
        "method": "GET",
        "url": "{{base_url_node}}/lab/permintaan?limit=50&offset=0"
      }
    },
    {
      "name": "11 - Dashboard (Node)",
      "request": {
        "method": "GET",
        "url": "{{base_url_node}}/dashboard/summary?start_date=2026-01-01&end_date=2026-12-31"
      }
    },
    {
      "name": "12 - Invoice PDF (Node)",
      "request": {
        "method": "GET",
        "url": "{{base_url_node}}/pdf/invoice/{{visit_id}}"
      }
    }
  ]
}
